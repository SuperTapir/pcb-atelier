{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main PCB Atelier window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-maximize",
    "core:window:allow-set-fullscreen",
    "core:window:allow-unmaximize",
    "dialog:allow-open"
  ]
}
