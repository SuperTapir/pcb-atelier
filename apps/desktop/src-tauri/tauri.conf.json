{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PCB Atelier",
  "version": "0.1.0",
  "identifier": "com.tapir.pcb-atelier",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PCB Atelier",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "dragDropEnabled": false,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
