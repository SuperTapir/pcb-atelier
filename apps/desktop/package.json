{
  "name": "@pcb-atelier/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "dev:e2e": "vite --mode e2e --host 127.0.0.1 --port 1423 --strictPort",
    "build": "tsc --noEmit && vite build",
    "benchmark:konva": "node scripts/run-konva-benchmark.mjs",
    "benchmark:konva:tauri": "node scripts/run-tauri-konva-benchmark.mjs",
    "benchmark:interactive-image": "node scripts/run-interactive-image-benchmark.mjs",
    "benchmark:konva:ui": "vite --host 127.0.0.1 --port 1422 --strictPort",
    "test": "vitest run src",
    "test:e2e": "npm run build && npm run verify:e2e-production-guard && playwright test",
    "verify:e2e-production-guard": "node scripts/verify-production-no-test-ipc.mjs",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "konva": "^10.3.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-konva": "^19.2.5",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.3",
    "playwright-core": "^1.62.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
